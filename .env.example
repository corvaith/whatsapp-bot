# WhatsApp number used to request the pairing code (international format, no +).
PAIRING_NUMBER=628xxxxxxxxxx

# Bot owner phone number(s) without the leading +; comma-separated for multiple owners.
OWNER_NUMBER=628xxxxxxxxxx

# Optional: owner LID(s), comma-separated. Also learned automatically at runtime
# when an owner message links its phone number and LID.
# OWNER_LID=123456789012345@lid

# Public mode: true lets anyone use public commands (default false; toggle at
# runtime with the owner .mode command).
# PUBLIC_MODE=false

# Command prefixes, comma-separated symbols. Runtime override via setprefix.
# PREFIX=.

# development enables plugin hot reload.
# NODE_ENV=production

# Application timezone (affects group analytics day boundaries).
# TZ=Asia/Jakarta
