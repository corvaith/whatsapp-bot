# WhatsApp number used to request the pairing code (international format, no +).
PAIRING_NUMBER=628xxxxxxxxxx

# Bot owner phone number(s) without the leading +; comma-separated for multiple owners.
OWNER_NUMBER=628xxxxxxxxxx

# Enable public command access (true/false). When false, only owners can use commands.
PUBLIC_MODE=false

# Pixelyte API base URL.
PIXELYTE_API_URL=https://api.pixelyte.zone.id

# Command prefixes, comma-separated (defaults to the built-in symbol set).
# Example: PREFIX=.,!,/
PREFIX=.

# Timeout in ms for media conversion jobs (video conversions take longer).
PIXELYTE_CONVERT_TIMEOUT_MS=180000

# Runtime environment: development enables plugin hot reload.
NODE_ENV=production

# Application timezone.
TZ=Asia/Jakarta
