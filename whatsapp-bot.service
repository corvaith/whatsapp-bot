[Unit]
Description=WhatsApp Bot (whatsapp-bot, bun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentuser
WorkingDirectory=/home/agentuser/bot
Environment=NODE_ENV=production
ExecStart=/home/agentuser/.bun/bin/bun --env-file=.env src/index.js
Restart=always
RestartSec=5
StandardOutput=append:/home/agentuser/bot/bot.log
StandardError=append:/home/agentuser/bot/bot.log

[Install]
WantedBy=multi-user.target
